digraph G {
    graph [bgcolor="#FCFCFA", fontname="Helvetica", fontcolor="#142C41",
           pad="0.45", nodesep="0.40", ranksep="0.65", splines=polyline,
           labelloc=t, labeljust=l, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#3F756A">FINGUARD / DESIGN BLUEPRINT / 04</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="28"><B>Low-level component design</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="15" COLOR="#4D6071">Application services and their control boundaries</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#60717D">Proposed design | October 2026 | Not an implemented system</FONT></TD></TR><TR><TD HEIGHT="20"></TD></TR></TABLE>>];
    node [shape=box, style="rounded,filled", fillcolor="#F0F3F7", color="#C9D4DC",
          penwidth=1, fontname="Helvetica", fontcolor="#142C41", fontsize=15,
          margin="0.20,0.14"];
    edge [color="#60778A", penwidth=1.3, arrowsize=0.7, fontname="Helvetica",
          fontcolor="#3B5366", fontsize=11];

  rankdir=TB;
  fontname="Helvetica";
  node [fontname="Helvetica"];
  edge [fontname="Helvetica"];

  subgraph cluster_entry {
    graph [style="rounded,filled", fillcolor="#F8FAFB", color="#D3DFE6", penwidth=1, margin=22, fontsize=14];

    label="Thin application entry points";
    web [label="apps/web\nReviewer screens", fillcolor="#F0F3F7"];
    api [label="apps/api\nValidate and route requests", fillcolor="#E7F4F0"];
    worker [label="apps/worker\nClaim durable jobs", fillcolor="#E7F4F0"];
  }

  subgraph cluster_backend {
    graph [style="rounded,filled", fillcolor="#F8FAFB", color="#D3DFE6", penwidth=1, margin=22, fontsize=14];

    label="Shared backend business components";
    identity [label="identity/\nMembership and authority", fillcolor="#E7F4F0"];
    cases [label="cases/\nReview lifecycle", fillcolor="#E7F4F0"];
    evidence [label="evidence/\nVersioned source references", fillcolor="#E7F4F0"];
    policies [label="policies/\nSnapshots and rule results", fillcolor="#E7F4F0"];
    modules [label="modules/\nSeven workflow evaluators", fillcolor="#E7F4F0"];
    approvals [label="approvals/\nIndependent reviewer checks", fillcolor="#FFF0D6"];
    actions [label="actions/ · M5 gateway\nFrozen proposal → intent\nPreflight and simulator", fillcolor="#E7F4F0"];
    persistence [label="persistence/\nRepositories / transactions\nJobs and outbox", fillcolor="#F0F3F7"];
    telemetry [label="telemetry/\nAudit interfaces / redaction", fillcolor="#F0F3F7"];
  }

  adapters [label="adapters/\nObjects • OIDC • OCR • AI\nPayment transport", fillcolor="#EEF0FC"];

  web -> api [label="Typed requests"];
  api -> identity [label="Authenticate / authorize"];
  api -> cases [label="Review operations"];
  api -> actions [label="Proposal / intent requests"];
  api -> approvals [label="Approval decisions"];
  worker -> policies [label="Evaluate queued work"];
  worker -> actions [label="Execute eligible intent"];
  cases -> evidence [label="Resolve source versions"];
  policies -> modules [label="Run domain evaluators"];
  policies -> evidence [label="Read frozen inputs"];
  actions -> approvals [label="Verify proposal approvals"];
  actions -> policies [label="Recheck controls"];
  cases -> persistence [label="Save state"];
  approvals -> persistence [label="Save decisions"];
  actions -> persistence [label="Atomic intent / outbox"];
  worker -> adapters [label="Bounded provider operations"];
  actions -> telemetry [label="Record transition"];
}
