digraph G {
    graph [bgcolor="#FCFCFA", fontname="Helvetica", fontcolor="#142C41",
           pad="0.45", nodesep="0.40", ranksep="0.65", splines=polyline,
           labelloc=t, labeljust=l, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#3F756A">FINGUARD / DESIGN BLUEPRINT / 08</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="28"><B>Finance user flow</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="15" COLOR="#4D6071">From an invoice to a reviewed, traceable simulation</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#60717D">Proposed design | October 2026 | Not an implemented system</FONT></TD></TR><TR><TD HEIGHT="20"></TD></TR></TABLE>>];
    node [shape=box, style="rounded,filled", fillcolor="#F0F3F7", color="#C9D4DC",
          penwidth=1, fontname="Helvetica", fontcolor="#142C41", fontsize=15,
          margin="0.20,0.14"];
    edge [color="#60778A", penwidth=1.3, arrowsize=0.7, fontname="Helvetica",
          fontcolor="#3B5366", fontsize=11];

  rankdir=TB;
  newrank=true;
  splines=spline;
  node [shape=box, style="rounded,filled", fillcolor="#F0F3F7"];

  subgraph cluster_evidence {
    graph [style="rounded,filled", fillcolor="#F8FAFB", color="#D3DFE6", penwidth=1, margin=22, fontsize=14];

    label="1. Evidence and checks";
    import [label="Import authorized invoice\nand supporting records", fillcolor="#E7F4F0"];
    fields [label="Inspect fields beside sources\nVerify critical facts"];
    correction [label="Correct fields or evidence\nCreate a new version\nPreserve original sources", fillcolor="#FFF0D6"];
    checks [label="Run current policies\nAmounts, duplicates, vendor\nEvidence and authority", fillcolor="#E7F4F0"];
    unknown [label="INDETERMINATE / incomplete\nObtain evidence or escalate\nDependent action stays held", fillcolor="#FBE9E8"];
    blocked [label="BLOCK\nNo direct approval override\nCorrect cause and recheck", fillcolor="#FBE9E8"];
  }

  subgraph cluster_review {
    graph [style="rounded,filled", fillcolor="#F8FAFB", color="#D3DFE6", penwidth=1, margin=22, fontsize=14];

    label="2. Accountable review";
    investigate [label="REVIEW finding\nAnalyst investigates\nPermitted resolution only", fillcolor="#FFF0D6"];
    proposal [label="Server freezes proposal\nRun action preflight\nBind evidence and policy\nFailures stay held"];
    reviewer [label="Independent approval\nReviewer checks authority\nNo self-approval", fillcolor="#FFF0D6"];
    rejected [label="Reject or return proposal\nRecord reason", fillcolor="#FBE9E8"];
    current [shape=diamond, style=filled, label="Approval current?\nPayload and versions match?", fillcolor="#FFF0D6"];
    invalidated [label="Invalidate stale approval\nChanged facts or authority\nRe-evaluate and reapprove", fillcolor="#FBE9E8"];
  }

  subgraph cluster_outcome {
    graph [style="rounded,filled", fillcolor="#F8FAFB", color="#D3DFE6", penwidth=1, margin=22, fontsize=14];

    label="3. First-release outcomes";
    simulator [label="Payment simulator\nNo money moves", fillcolor="#E7F4F0"];
    report [label="Export reviewed history\nEvidence, actors and versions\nNo real payment or posting", fillcolor="#E7F4F0"];
  }

  { rank=same; correction; checks; investigate; }
  correction -> checks -> investigate [style=invis, weight=100];
  investigate -> proposal [style=invis, weight=20];
  { rank=same; current; simulator; }
  current -> simulator [style=invis, weight=100];
  { rank=same; unknown; blocked; }
  unknown -> blocked [style=invis, weight=100];

  import -> fields;
  fields -> correction [label="incorrect field"];
  correction -> fields [label="new version"];
  fields -> unknown [label="missing critical fact"];
  fields -> checks [label="critical facts verified"];
  checks -> unknown [label="required check incomplete"];
  checks -> blocked [label="BLOCK"];
  checks:e -> investigate:w [label="REVIEW", constraint=false];
  checks:e -> proposal:w [label="PASS", constraint=false];
  unknown -> correction [label="new evidence available", constraint=false];
  blocked -> correction [label="verified correction", constraint=false];
  investigate:s -> correction:s [label="source correction", constraint=false];
  investigate:w -> checks:e [label="resolution version", constraint=false];
  proposal -> reviewer [label="eligible action only"];
  reviewer -> rejected [label="reject / return"];
  reviewer -> current [label="approve exact proposal"];
  current -> invalidated [label="no"];
  invalidated:w -> checks:e [label="re-evaluate", constraint=false];
  current:e -> report:w [label="yes: report only", constraint=false];
  current:e -> simulator:w [label="yes: simulation requested", constraint=false];
  simulator -> report [label="simulated receipt"];
}
