digraph G {
    graph [bgcolor="#FCFCFA", fontname="Helvetica", fontcolor="#142C41",
           pad="0.45", nodesep="0.40", ranksep="0.65", splines=polyline,
           labelloc=t, labeljust=l, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#3F756A">FINGUARD / DESIGN BLUEPRINT / 03</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="28"><B>Technology stack</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="15" COLOR="#4D6071">Proposed development and pilot-hosting choices</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#60717D">Proposed design | October 2026 | Not an implemented system</FONT></TD></TR><TR><TD HEIGHT="20"></TD></TR></TABLE>>];
    node [shape=box, style="rounded,filled", fillcolor="#F0F3F7", color="#C9D4DC",
          penwidth=1, fontname="Helvetica", fontcolor="#142C41", fontsize=15,
          margin="0.20,0.14"];
    edge [color="#60778A", penwidth=1.3, arrowsize=0.7, fontname="Helvetica",
          fontcolor="#3B5366", fontsize=11];

  rankdir=TB;
  fontname="Helvetica";
  node [fontname="Helvetica"];
  edge [fontname="Helvetica"];

  subgraph cluster_application {
    graph [style="rounded,filled", fillcolor="#F8FAFB", color="#D3DFE6", penwidth=1, margin=22, fontsize=14];

    label="Application code";
    web [label="Next.js / React\nTypeScript / Tailwind\nAccessible review UI", fillcolor="#E7F4F0"];
    api [label="Python / FastAPI\nPydantic / OpenAPI", fillcolor="#E7F4F0"];
    workers [label="Python workers\nPostgreSQL jobs / outbox", fillcolor="#E7F4F0"];
    rules [label="Versioned JSON rules\nPython evaluators / Decimal", fillcolor="#E7F4F0"];
    { rank=same; web; api; workers; rules; }
  }

  subgraph cluster_managed {
    graph [style="rounded,filled", fillcolor="#F8FAFB", color="#D3DFE6", penwidth=1, margin=22, fontsize=14];

    label="Persistence and replaceable providers";
    postgres [label="PostgreSQL / RDS\nSQLAlchemy / Alembic\nTransactions and tenant RLS", fillcolor="#F0F3F7", shape=cylinder];
    objects [label="Private Amazon S3\nLocal adapter for development", fillcolor="#F0F3F7", shape=cylinder];
    identity [label="OIDC / Cognito\nSign-in and MFA", fillcolor="#F0F3F7"];
    ocr [label="pypdf / Tesseract\nOptional Textract", fillcolor="#EEF0FC"];
    model [label="Amazon Bedrock\nPinned model adapter\nOptional content guardrails", fillcolor="#EEF0FC"];
    { rank=same; postgres; objects; identity; }
    { rank=same; ocr; model; }
    // Invisible ordering edges express layout only, not system dependencies.
    objects -> ocr [style=invis];
    identity -> model [style=invis];
  }

  subgraph cluster_delivery {
    graph [style="rounded,filled", fillcolor="#F8FAFB", color="#D3DFE6", penwidth=1, margin=22, fontsize=14];

    label="Build, operate and verify";
    tests [label="pytest / Hypothesis\nVitest / Playwright / axe", fillcolor="#F0F3F7"];
    delivery [label="GitHub Actions\nTests / scans / reviewed build", fillcolor="#F0F3F7"];
    runtime [label="Docker Compose locally\nECS Fargate / ECR in cloud", fillcolor="#F0F3F7"];
    infra [label="Terraform\nReviewed environment plans", fillcolor="#F0F3F7"];
    observe [label="OpenTelemetry / CloudWatch\nSecrets Manager / KMS", fillcolor="#F0F3F7"];
    { rank=same; tests; delivery; infra; }
    { rank=same; runtime; observe; }
  }

  web -> api [label="Generated API contracts"];
  api -> identity [label="Validate identity"];
  api -> rules [label="Validate financial actions"];
  workers -> rules [label="Evaluate frozen inputs"];
  api -> postgres [label="Persist business state"];
  workers -> postgres [label="Durable processing"];
  workers -> objects [label="Evidence / exports"];
  workers -> ocr [label="Extract candidate fields"];
  workers -> model [label="Bounded assistance"];
  delivery -> tests [label="Run checks"];
  delivery -> runtime [label="Deploy validated images"];
  infra -> runtime [label="Provision configuration"];
  runtime -> observe [label="Use operational services"];
  // Keep the delivery group below the application/provider layers.
  model -> delivery [style=invis, minlen=1];
}
