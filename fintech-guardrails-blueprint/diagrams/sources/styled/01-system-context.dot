digraph G {
    graph [bgcolor="#FCFCFA", fontname="Helvetica", fontcolor="#142C41",
           pad="0.45", nodesep="0.40", ranksep="0.65", splines=polyline,
           labelloc=t, labeljust=l, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#3F756A">FINGUARD / DESIGN BLUEPRINT / 01</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="28"><B>System context</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="15" COLOR="#4D6071">People, source systems and provider boundaries</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#60717D">Proposed design | October 2026 | Not an implemented system</FONT></TD></TR><TR><TD HEIGHT="20"></TD></TR></TABLE>>];
    node [shape=box, style="rounded,filled", fillcolor="#F0F3F7", color="#C9D4DC",
          penwidth=1, fontname="Helvetica", fontcolor="#142C41", fontsize=15,
          margin="0.20,0.14"];
    edge [color="#60778A", penwidth=1.3, arrowsize=0.7, fontname="Helvetica",
          fontcolor="#3B5366", fontsize=11];

  rankdir=LR;
  fontname="Helvetica";
  node [fontname="Helvetica"];
  edge [fontname="Helvetica"];

  subgraph cluster_people {
    graph [style="rounded,filled", fillcolor="#F8FAFB", color="#D3DFE6", penwidth=1, margin=22, fontsize=14];

    label="Customer organization";
    operators [label="Finance / compliance\noperators", fillcolor="#F0F3F7"];
    approvers [label="Independent\napprovers", fillcolor="#FFF0D6"];
    admins [label="Organization\nadministrators", fillcolor="#F0F3F7"];
    auditors [label="Read-only\nauditors", fillcolor="#F0F3F7"];
    { rank=same; operators; approvers; admins; auditors; }
  }

  app [label="Unified financial\ncontrols web app\nEvidence • rules • approvals", fillcolor="#E7F4F0"];
  identity [label="Managed identity\nOIDC / Cognito", fillcolor="#F0F3F7"];

  subgraph cluster_sources {
    graph [style="rounded,filled", fillcolor="#F8FAFB", color="#D3DFE6", penwidth=1, margin=22, fontsize=14];

    label="External systems and providers";
    accounting [label="Accounting / ERP", fillcolor="#F0F3F7"];
    statements [label="Bank / processor\nstatement sources", fillcolor="#F0F3F7"];
    ai [label="OCR / AI providers\nBounded assistance", fillcolor="#EEF0FC"];
    verification [label="Identity / screening\nproviders · later", fillcolor="#EEF0FC"];
    payment [label="Live payment provider\nLater release", fillcolor="#EEF0FC"];
    { rank=same; accounting; statements; ai; verification; payment; }
  }

  agent [label="External AI agent\nScoped requests · later", fillcolor="#EEF0FC"];
  operators -> app [label="Submit and investigate"];
  approvers -> app [label="Review exact proposals"];
  admins -> app [label="Configure access / settings"];
  auditors -> app [label="Inspect history"];
  identity -> app [label="Verified identity"];
  app -> accounting [dir=both, label="Records / approved exports"];
  app -> statements [dir=back, label="Statements / settlements"];
  app -> ai [dir=both, label="Bounded input / suggestions"];
  app -> verification [dir=back, label="Verification evidence"];
  agent -> app [label="Proposed actions"];
  app -> payment [dir=both, label="Authorized requests / status\nLater release"];
}
