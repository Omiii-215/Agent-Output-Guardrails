digraph G {
    graph [bgcolor="#FCFCFA", fontname="Helvetica", fontcolor="#142C41",
           pad="0.45", nodesep="0.40", ranksep="0.65", splines=polyline,
           labelloc=t, labeljust=l, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#3F756A">FINGUARD / DESIGN BLUEPRINT / 13</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="28"><B>Implementation roadmap</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="15" COLOR="#4D6071">12-16 weeks assumes two experienced builders and accessible data</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#60717D">Proposed design | October 2026 | Not an implemented system</FONT></TD></TR><TR><TD HEIGHT="20"></TD></TR></TABLE>>];
    node [shape=box, style="rounded,filled", fillcolor="#F0F3F7", color="#C9D4DC",
          penwidth=1, fontname="Helvetica", fontcolor="#142C41", fontsize=15,
          margin="0.20,0.14"];
    edge [color="#60778A", penwidth=1.3, arrowsize=0.7, fontname="Helvetica",
          fontcolor="#3B5366", fontsize=11];

  rankdir=TB;
  nodesep=0.5;
  ranksep=0.42;
  node [shape=box, style="rounded,filled", fillcolor="#F0F3F7"];

  assumption [label="Planning assumption\n2 experienced builders +\nregular finance-domain input\n12–16 weeks: first MVP + pilot", fillcolor="#E7F4F0", group="stage"];
  timing [label="Solo / learning the stack:\n4–6 months or longer\nProvisional effort ranges;\nnot delivery commitments", fillcolor="#FFF0D6", group="gate"];
  {rank=same; assumption; timing;}
  assumption -> timing [style=dashed, arrowhead=none];

  discovery [label="1 · Discovery | Weeks 1–2\nObserve one buyer workflow\nDefine data + label fixtures\nAgree baseline and scope", fillcolor="#E7F4F0", group="stage"];
  gate1 [label="GATE\nNamed pilot champion\nUsable, authorized or\nsynthetic example records", fillcolor="#FFF0D6", group="gate"];
  {rank=same; discovery; gate1;}
  assumption -> discovery;
  discovery -> gate1;

  foundations [label="2 · Foundation | Weeks 3–4\nIdentity + tenant isolation\nCases, evidence and audit\nDurable jobs + staging", group="stage"];
  gate2 [label="GATE\nIsolation tests pass\nJobs survive restart\nAccess changes take effect", fillcolor="#FFF0D6", group="gate"];
  {rank=same; foundations; gate2;}
  gate1 -> foundations [label="pass", constraint=false];
  foundations -> gate2;

  invoice [label="3 · Invoice review | Weeks 5–7\nUpload, extract and correct\nTotals / duplicates / vendor\nEvidence + versioned rules", group="stage"];
  gate3 [label="GATE\nReviewer flow works\nUncertainty routes to review\nChecks are reproducible", fillcolor="#FFF0D6", group="gate"];
  {rank=same; invoice; gate3;}
  gate2 -> invoice [label="pass", constraint=false];
  invoice -> gate3;

  reconciliation [label="4 · Connect | Weeks 8–10\nReconciliation exceptions\nPayload-bound approvals\nPayment simulation only", group="stage"];
  gate4 [label="GATE\nMatching evaluation passes\nStale / self approvals fail\nRetry + timeout cases pass", fillcolor="#FFF0D6", group="gate"];
  {rank=same; reconciliation; gate4;}
  gate3 -> reconciliation [label="pass", constraint=false];
  reconciliation -> gate4;

  readiness [label="5 · Readiness | Weeks 11–12\nMonitor, restore and export\nSecurity + evaluation review\nSupport and recovery runbooks", group="stage"];
  gate5 [label="GATE\nNo blocking control defects\nData arrangements agreed\nRestore + rollback rehearsed", fillcolor="#FFF0D6", group="gate"];
  {rank=same; readiness; gate5;}
  gate4 -> readiness [label="pass", constraint=false];
  readiness -> gate5;

  pilot [label="6 · Pilot | Weeks 13–16\nHistorical / advisory work\nCompare quality, time + cost\nTest willingness to pay", group="stage"];
  gate6 [label="GATE\nBuyer reviews measured value\nPurchase, revise or stop\nRecord unresolved failures", fillcolor="#FFF0D6", group="gate"];
  {rank=same; pilot; gate6;}
  gate5 -> pilot [label="pass", constraint=false];
  pilot -> gate6;

  later [label="Later: independent validation\nAML · chargebacks · KYC/KYB\nUnderwriting · communications\nNo delivery date assumed", fillcolor="#EEF0FC", group="stage"];
  guard [label="If a gate fails:\nfix, narrow or stop.\nThe pilot does not validate\neight production modules.", fillcolor="#FFF0D6", group="gate"];
  {rank=same; later; guard;}
  gate6 -> later [label="funded need +\ndomain validation", style=dashed, constraint=false];
  later -> guard [style=invis];

  // Keep each milestone and its gate in stable left / right columns.
  discovery -> foundations -> invoice -> reconciliation -> readiness -> pilot -> later [style=invis, weight=100];
  timing -> gate1 -> gate2 -> gate3 -> gate4 -> gate5 -> gate6 -> guard [style=invis, weight=100];
}
