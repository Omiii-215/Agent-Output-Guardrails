# Copy to .env for local overrides. Never put real credentials or customer data here.
FINGUARD_ENV=development
FINGUARD_DATABASE_URL=sqlite:///var/finguard.sqlite3
# FINGUARD_DATABASE_ADMIN_URL=postgresql+psycopg://owner@localhost/finguard
FINGUARD_MODEL_PROVIDER=fake
# FINGUARD_BEDROCK_MODEL_ID=   # selected only after evaluation (ADR 0005)
# FINGUARD_BEDROCK_GUARDRAIL_ID=
# FINGUARD_BEDROCK_GUARDRAIL_VERSION=
# Required outside development (the app refuses dev defaults in staging/production):
# FINGUARD_OBJECT_GRANT_SECRET=
# FINGUARD_FIELD_ENCRYPTION_KEY=
# FINGUARD_SIMULATOR_WEBHOOK_SECRET=
# FINGUARD_OIDC_ISSUER=https://cognito-idp.ap-south-1.amazonaws.com/<pool-id>
# FINGUARD_OIDC_AUDIENCE=<app-client-id>
# FINGUARD_DEV_IDENTITY_ENABLED=false
